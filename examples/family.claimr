% A classic: parents, ancestors, siblings — pure resolution with backtracking.
parent(tom, bob).
parent(tom, liz).
parent(bob, ann).
parent(bob, pat).
parent(pat, jim).

grandparent(X, Z) :- parent(X, Y), parent(Y, Z).
ancestor(X, Y) :- parent(X, Y).
ancestor(X, Y) :- parent(X, Z), ancestor(Z, Y).
sibling(X, Y) :- parent(P, X), parent(P, Y), { X != Y }.

?- parent(tom, X).
?- grandparent(tom, Who).
?- ancestor(tom, jim).
?- ancestor(X, jim).
?- sibling(ann, S).
?- parent(jim, X).
