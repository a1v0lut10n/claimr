X = y
?- well_supported(k).
true
?- well_supported(j).
false
?- total(T).
T = 1
?- average(A).
A = 1/3
?- { L = <X | p(X)> }.
L = <1, 2, 3>
?- { Pairs = <<X, Y> | p(X), p(Y), { X < Y }> }.
Pairs = <<1, 2>, <1, 3>, <2, 3>>
?- { L = <X | p(X), { X > 7 }> }.
L = <>
?- { Below = <<X, |<Y | p(Y), { Y < X }>|> | p(X)> }.
Below = <<1, 0>, <2, 1>, <3, 2>>
