% Lists (CLM-0014, docs/design/2026-11-09-lists-as-a-constraint-domain.md,
% stage 1): `<>` is the empty list, `<a, b, c>` a list, and `<a, b> . T` the
% chain a, b then T — the cons pattern in a head. A list is the chain of
% '<>'(H, T) cells ending in '<>', so '<>'(a, '<>') is the same term as <a>.
append(<>, L, L).
append(<H> . T, L, <H> . R) :- append(T, L, R).

member(X, <X> . _).
member(X, <_> . T) :- member(X, T).

reverse(<>, <>).
reverse(<H> . T, R) :- reverse(T, RT), append(RT, <H>, R).

length(<>, zero).
length(<_> . T, s(N)) :- length(T, N).

?- append(<1, 2>, <3>, L).
?- append(X, Y, <a, b>).
?- member(X, <a, b, c>).
?- member(b, <a, b, c>).
?- reverse(<1, 2, 3>, R).
?- length(<a, b>, N).
?- length(L, s(s(zero))).
?- { L = <1, 2> . T }.
?- { X = <a> . <b> . T }.
?- { X = <1> . X }.
?- { '<>'(a, '<>') = <a> }.
?- { X = <<1, 2>, <>, f(<a>)> }.
?- member(_, <a, b>).
?- append(<1>, _, L).
?- { X = <_, _> }.
