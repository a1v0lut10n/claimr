?- append(<1, 2>, <3>, L).
L = <1, 2, 3>
?- append(X, Y, <a, b>).
X = <>, Y = <a, b>
X = <a>, Y = <b>
X = <a, b>, Y = <>
?- member(X, <a, b, c>).
X = a
X = b
X = c
?- member(b, <a, b, c>).
true
?- reverse(<1, 2, 3>, R).
R = <3, 2, 1>
?- length(<a, b>, N).
N = s(s(zero))
?- length(L, s(s(zero))).
L = <_1, _2>
?- { L = <1, 2> . T }.
L = <1, 2> . T
?- { X = <a, b> . T }.
X = <a, b> . T
?- { X = <1> . X }.
X = <1> . X
?- { '<>'(a, '<>') = <a> }.
true
?- { X = <<1, 2>, <>, f(<a>)> }.
X = <<1, 2>, <>, f(<a>)>
